# ===========================================================================
#  Ficheros sensibles — NUNCA deben subirse a GitHub
# ===========================================================================

# --- Variables de entorno (solo se documenta la plantilla) -----------------
.env
.env.*
*.env
!.env.example
!.env.sample
!.env.template

# --- Claves privadas y certificados ---------------------------------------
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.ppk

# --- Tokens, credenciales y cuentas de servicio ---------------------------
*.token
*.secret
secrets.*
credentials.json
*credentials*.json
*service-account*.json
*serviceAccount*.json
.npmrc
.netrc
.htpasswd

# --- Configuración local de herramientas que suele contener credenciales ---
.aws/
.ssh/
.docker/config.json
.kube/
.config/gcloud/

# --- Volcados y datos locales ---------------------------------------------
*.sqlite
*.sqlite3
*.db
*.dump
dump.sql

# ===========================================================================
#  Dependencias y artefactos de build (no son código fuente)
# ===========================================================================
node_modules
dist
dist-ssr
.vite

# ===========================================================================
#  Cachés, logs y cobertura
# ===========================================================================
*.log
*.tsbuildinfo
.eslintcache
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/

# ===========================================================================
#  Sistema operativo y editores
# ===========================================================================
.DS_Store
Thumbs.db
desktop.ini
*.local
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json
